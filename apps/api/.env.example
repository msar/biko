# Local: Postgres embebido (npm run dev:db) o docker-compose (puerto 5432)
DATABASE_URL="postgresql://biko:biko@localhost:5433/biko"
# Local only. In Railway set a long random literal once and never rotate
# (rotation / ${{ secret() }} logs everyone out on deploy).
JWT_SECRET="dev-secret-change-me"
# Optional: previous secret while rotating (remove after all clients re-login).
# JWT_SECRET_PREVIOUS=
# CORS_ORIGIN="https://tu-web.up.railway.app" (coma-separado; sin setear = permitir todo)

# Passkeys / WebAuthn (RP = origen del front; en prod fallan las rutas si faltan)
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGIN="http://localhost:5173"

# Web Push (generar con: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vos@example.com

# Cron diario de recurrentes: POST /internal/jobs/recurring con header X-Cron-Secret
# CRON_SECRET=change-me
